const fetchWeather = async (lat, lon) => {
  const apiKey = import.meta.env.VITE_PIRATE_WEATHER_API_KEY
  
  if (!apiKey) {
    console.error("Pirate Weather API key is missing!")
    return
  }

  try {
    // Pirate Weather API endpoint format
    const url = `https://api.pirateweather.net/forecast/${apiKey}/${lat},${lon}`
    const response = await axios.get(url, {
      params: {
        units: 'si' // Use 'us' for Fahrenheit if preferred
      }
    })
    weather.value = response.data
  } catch (error) {
    console.error('Error fetching Pirate Weather:', error)
  }
}